# エディタ共通の基本設定（VS Code 以外のエディタでも同じ見た目にする）
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 120

[*.py]
indent_size = 4

[*.md]
# Markdown の行末の空白2つは改行の意味を持つので消さない
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
