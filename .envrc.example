# ローカル開発用の環境変数。`cp .envrc.example .envrc` してから値を埋め、`direnv allow` する。
# .envrc は秘密情報を含むので git に入れない。本番ではこのファイルを使わず、環境変数を直接渡す。

# --- バックエンド（Django） ---
export DJANGO_SETTINGS_MODULE=app.settings
export YORIKI_SECRET_KEY=dev-only-change-me
export YORIKI_DEBUG=true
export YORIKI_ALLOWED_HOSTS=localhost,127.0.0.1
# 本番では公開URL（例：https://yoriki.example.co.jp）。カンマ区切り
# export YORIKI_CSRF_TRUSTED_ORIGINS=
# セッションとCSRFのCookieにSecureを付けるか。開発（http://localhost）だけfalseにする。本番では設定しない（既定はtrue）
export YORIKI_COOKIE_SECURE=false
export YORIKI_DATABASE_NAME=yoriki
export YORIKI_DATABASE_USER=yoriki
export YORIKI_DATABASE_PASSWORD=yoriki
export YORIKI_DATABASE_HOST=localhost
export YORIKI_DATABASE_PORT=5432
# 接続プールの大きさ（プロセスごと。backend-conventions.md §6.1）
# export YORIKI_DATABASE_POOL_MIN=2
# export YORIKI_DATABASE_POOL_MAX=10

# 管理画面で登録するSecret（LLMのAPI key、Connectorのパスワード等）をDBに暗号化して保存する鍵（Fernet）。
# 次のコマンドで作る。カンマ区切りで複数を書くと、先頭で暗号化し、すべての鍵で復号する（deployment.md §5）
#   cd api && uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# export YORIKI_SECRET_ENCRYPTION_KEYS=

# --- Django Q2（qcluster） ---
# qclusterのworker数と、1つのqclusterで同時に動かすRunの数（既定は worker数 − 1。deployment.md §3.2）
# export YORIKI_Q_WORKERS=4
# export YORIKI_RUNS_PER_QCLUSTER=3
# macOSでは、forkしたworkerがHTTPの接続（システムのライブラリ）を使うと落ちるので、確認を止める（Linuxでは不要）
export OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES

# --- 社内SSO ---
# 認証基盤（Microsoft 365・Google Workspace）の設定は、環境変数ではなく管理画面（/manage/sso_providers）で登録する。
# 開発時のリダイレクトURIは http://localhost:3000/api/accounts/<microsoft|google>/login/callback/ になる

# --- Sandbox ---
# Workerの作業領域（ジョブの出力、Workspaceのsnapshot）。既定の /var/lib/yoriki/workspaces は手元では書けないので、
# リポジトリの中の .workspaces/（gitに入れない）にする
export YORIKI_WORKSPACES_DIR="$PWD/.workspaces"
# 手元でビルドしたSandboxイメージに差し替える（開発時だけ有効。本番では無視する。deployment.md §3.3）
# export YORIKI_SANDBOX_IMAGE_OVERRIDE=yoriki-sandbox-docs:dev
# Runtime Profileに登録できるイメージのレジストリ（既定は docker.io）。ghcr.io 等も使うときに足す
# export YORIKI_SANDBOX_REGISTRIES=docker.io,ghcr.io
# HTTPで読むレジストリ。手元に立てたレジストリ（docker run -p 5001:5000 registry:3）にpushしたイメージを、
# Runtime Profileとして登録して試すときだけ使う（本番では設定しない）
# export YORIKI_SANDBOX_INSECURE_REGISTRIES=localhost:5001

# --- フロントエンド（Nuxt） ---
# 開発サーバーが /api を転送する先（既定は http://localhost:8000）
# export YORIKI_DEV_API_ORIGIN=http://localhost:8000
