# Composeファイル自体の変数（docs/deployment.md §5）。deploy/.env にコピーして使う。秘密情報は書かない。

# 本体のイメージ。ソースからビルドして自前のレジストリに置き、digestで固定する
#   例：registry.example.co.jp/yoriki-api@sha256:...
# 手元でビルドするだけなら、任意の名前にして `docker compose -f deploy/compose.yaml build` でもよい
YORIKI_API_IMAGE=yoriki-api:local
YORIKI_FRONTEND_IMAGE=yoriki-frontend:local

# 環境変数のファイル（既定は /etc/yoriki/ 以下）
# YORIKI_ENV_FILE=/etc/yoriki/yoriki.env
# YORIKI_DB_ENV_FILE=/etc/yoriki/postgres.env
# YORIKI_CLOUDFLARED_ENV_FILE=/etc/yoriki/cloudflared.env

# nginxのTLS証明書のディレクトリ（fullchain.pem、privkey.pem。compose.yaml）
# YORIKI_NGINX_CERTS_DIR=/etc/yoriki/certs

# apiのUvicornのワーカー数
# YORIKI_API_WORKERS=4

# ホストのdockerグループのGID（qclusterがDockerソケットを使うため。`getent group docker` で確認する）
# YORIKI_DOCKER_GID=999

# 複数台構成で、nginx・postgresが待ち受ける私設ネットワークのアドレス（compose.app.yaml、compose.db.yaml）
# YORIKI_PRIVATE_BIND=10.0.1.11
# YORIKI_HTTP_PORT=80

# エッジのnginxの振り分け先の設定のディレクトリ（compose.edge.yaml。app-servers.conf を置く）
# YORIKI_EDGE_CONF_DIR=/etc/yoriki/edge
