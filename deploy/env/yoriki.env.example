# 本番の環境変数（docs/deployment.md §5）。/etc/yoriki/yoriki.env（所有者root、権限600）にコピーして値を埋める。
# 新しい変数を追加したら、リポジトリルートの .envrc.example と合わせて更新する。
# 複数台構成では、アプリサーバーとWorkerサーバーで同じ内容にする。

# --- Django ---
DJANGO_SETTINGS_MODULE=app.settings
YORIKI_SECRET_KEY=
YORIKI_DEBUG=false
# 公開するホスト名。コンテナのヘルスチェックが localhost で呼ぶので localhost も含める
YORIKI_ALLOWED_HOSTS=yoriki.example.co.jp,localhost
# 公開URL（例：https://yoriki.example.co.jp）
YORIKI_CSRF_TRUSTED_ORIGINS=
YORIKI_TIME_ZONE=Asia/Tokyo
# YORIKI_LOG_LEVEL=INFO

# --- DB（単一ホストの compose.yaml では HOST=postgres） ---
YORIKI_DATABASE_NAME=yoriki
YORIKI_DATABASE_USER=yoriki
YORIKI_DATABASE_PASSWORD=
YORIKI_DATABASE_HOST=postgres
YORIKI_DATABASE_PORT=5432
# 接続プールの大きさ（プロセスごと。backend-conventions.md §6.1）
# YORIKI_DATABASE_POOL_MIN=2
# YORIKI_DATABASE_POOL_MAX=10

# --- Django Q2 ---
# YORIKI_Q_WORKERS=2
# YORIKI_Q_RUNNER_WORKERS=2

# --- LLMプロバイダのAPI key（使うものだけ。管理画面のSecret参照に env:変数名 で登録する） ---
# YORIKI_OPENAI_API_KEY=
# YORIKI_ANTHROPIC_API_KEY=
# YORIKI_GEMINI_API_KEY=

# --- 社内SSO（backend-conventions.md §6.2） ---
YORIKI_SSO_PROVIDERS=
YORIKI_SSO_ALLOWED_EMAIL_DOMAINS=
# YORIKI_SSO_MICROSOFT_CLIENT_ID=
# YORIKI_SSO_MICROSOFT_CLIENT_SECRET=
# YORIKI_SSO_MICROSOFT_TENANT_ID=
# YORIKI_SSO_GOOGLE_CLIENT_ID=
# YORIKI_SSO_GOOGLE_CLIENT_SECRET=
# YORIKI_SSO_GOOGLE_HOSTED_DOMAIN=
