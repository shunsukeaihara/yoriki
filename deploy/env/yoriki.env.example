# 本番の環境変数（docs/deployment.md §5）。/etc/yoriki/yoriki.env（所有者root、権限600）にコピーして値を埋める。
# 新しい変数を追加したら、リポジトリルートの .envrc.example と合わせて更新する。
# 複数台構成では、アプリサーバーとWorkerサーバーで同じ内容にする。

# --- Django ---
DJANGO_SETTINGS_MODULE=app.settings
YORIKI_SECRET_KEY=
YORIKI_DEBUG=false
# 公開するホスト名。コンテナのヘルスチェックが localhost で呼ぶので localhost も含める
YORIKI_ALLOWED_HOSTS=yoriki.example.co.jp,localhost
# 公開URL（例：https://yoriki.example.co.jp）
YORIKI_CSRF_TRUSTED_ORIGINS=
YORIKI_TIME_ZONE=Asia/Tokyo
# YORIKI_LOG_LEVEL=INFO

# --- DB（単一ホストの compose.yaml では HOST=postgres） ---
YORIKI_DATABASE_NAME=yoriki
YORIKI_DATABASE_USER=yoriki
YORIKI_DATABASE_PASSWORD=
YORIKI_DATABASE_HOST=postgres
YORIKI_DATABASE_PORT=5432
# 接続プールの大きさ（プロセスごと。backend-conventions.md §6.1）
# YORIKI_DATABASE_POOL_MIN=2
# YORIKI_DATABASE_POOL_MAX=10

# --- Django Q2 ---
# qclusterのworker数（同時に処理するtaskの数）
# YORIKI_Q_WORKERS=4
# 1つのqclusterで同時に動かすRunの数。既定は worker数 − 1（配信等の軽い処理のworkerを残す）
# YORIKI_RUNS_PER_QCLUSTER=3

# --- Secretの暗号化（docs/deployment.md §5） ---
# 管理画面で登録するSecret（LLMのAPI key、Connectorのパスワード等）をDBに暗号化して保存する鍵（Fernet。カンマ区切り）。
# 生成: docker compose -f deploy/compose.yaml run --rm api python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 失うと登録したSecretを復号できなくなるので、DBのバックアップとは別の場所にも控える
YORIKI_SECRET_ENCRYPTION_KEYS=

# --- ファイルの保存先（添付・成果物・Workspaceのsnapshot。docs/design.md §7.8、docs/deployment.md §5.1） ---
# local（サーバーのディスク）か s3。Workerを別のサーバーに置くときは s3 にする
YORIKI_STORAGE_BACKEND=local
# 保存先のID。保存したファイルの記録に残るので、物理的な保存先（rootやbucket）を変えるときは別のIDにする
# YORIKI_STORAGE_ID=local-main
# 以前の保存先（読むだけ。IDやLocalからS3へ変えた後も、そこに保存したファイルを読む。docs/design.md §7.10）。JSONで書く
# YORIKI_STORAGE_PREVIOUS={"local-main": {"backend": "local", "root": "/var/lib/yoriki/objects"}}
# local：保存するディレクトリ（コンテナの利用者 uid 10001 が書けるようにする）と、nginxから返すときの内部location
# YORIKI_STORAGE_LOCAL_ROOT=/var/lib/yoriki/objects
YORIKI_STORAGE_ACCEL_REDIRECT=/_protected/
# s3：非公開のbucket。資格情報はIAM role（インスタンスプロファイル等）か、AWS_ACCESS_KEY_ID・AWS_SECRET_ACCESS_KEY で渡す
# YORIKI_STORAGE_S3_BUCKET=
# YORIKI_STORAGE_S3_PREFIX=production/
# YORIKI_STORAGE_S3_REGION=ap-northeast-1
# S3互換のストレージのときだけ（動作を確かめてから使う）
# YORIKI_STORAGE_S3_ENDPOINT_URL=
# 添付の1つのファイルの上限（MB）と、1つのメッセージに付けられる数
# YORIKI_UPLOAD_MAX_MB=50
# YORIKI_ATTACHMENTS_PER_MESSAGE=20
# 添付と成果物の保持期間（日）
# YORIKI_ARTIFACT_RETENTION_DAYS=90

# --- 結果の配信（docs/design.md §4.4） ---
# 出口（Webhook・Zapier）の送り先に許す社内のネットワーク（CIDR。カンマ区切り）。既定では社内のアドレスへは送らない
# YORIKI_DELIVERY_ALLOWED_NETWORKS=10.0.0.0/8
# 外（Zapier等）から見たYorikiのURL。出口へ渡す成果物の取得用のURL（/api/files/<token>/）の元にする。
# 未設定なら、成果物を渡す配信は失敗にする
# YORIKI_PUBLIC_URL=https://yoriki.example.co.jp

# --- 社内SSO ---
# 認証基盤（Microsoft 365・Google Workspace）の設定は、環境変数ではなく管理画面（/manage/sso_providers）で登録する

# --- Sandbox（docs/design.md §7.3） ---
# Workerの作業領域（ジョブの出力、Sandboxに見せる添付）。qclusterのコンテナとホストで同じパスにし、
# コンテナの利用者（uid 10001）が書けるようにする（docs/deployment.md §3.1）
# YORIKI_WORKSPACES_DIR=/var/lib/yoriki/workspaces
# Runtime Profileに登録できるイメージのレジストリ（カンマ区切り。既定は docker.io）
# YORIKI_SANDBOX_REGISTRIES=docker.io
# Sandboxを動かすコンテナの実行環境（Dockerに登録した名前）。既定はgVisorの runsc で、Workerのホストに
# 入れておく（docs/deployment.md §7.1）。入れられない環境だけ runc にする（Launcherがログに警告を出す）
# YORIKI_SANDBOX_RUNTIME=runsc
